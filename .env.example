# WhatsApp Task Manager Configuration

# Required: WhatsApp MCP database paths
WHATSAPP_MESSAGES_DB=/path/to/whatsapp-mcp/whatsapp-bridge/store/messages.db
WHATSAPP_CHATS_DB=/path/to/whatsapp-mcp/whatsapp-bridge/store/whatsapp.db

# Optional: Local tasks database (defaults to tasks.db in current directory)
TASKS_DB=tasks.db

# Optional: Ollama settings
OLLAMA_MODEL=qwen3:4b
OLLAMA_URL=http://localhost:11434

# Required: Monitored phone numbers (comma-separated, plain numbers or full JIDs)
MONITORED_NUMBERS=5511999999999,5511888888888@s.whatsapp.net

# Required: Group keywords to monitor (comma-separated)
MONITORED_GROUP_KEYWORDS=WORK,FAMILY

# Optional: Polling interval in seconds
POLL_INTERVAL=30

# Optional: Daily log housekeeping (daemon/watch mode)
# Set to 0/false/no/off to disable automatic daily cleanup
LOG_CLEANUP_DAILY=1
# Comma-separated log files to truncate once per day when watch mode is running
LOG_FILES=/tmp/whatsapp-tasks.log,/tmp/whatsapp-tasks.err.log

# Optional: Skip database validation (for testing)
# SKIP_DB_VALIDATION=1

# Optional: Email notifications
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=starttls   # options: tls, starttls, none
MAIL_TO=recipient@example.com
MAIL_FROM=recipient@example.com
