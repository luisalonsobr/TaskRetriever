# WhatsApp MCP database paths
WHATSAPP_MESSAGES_DB=/path/to/whatsapp-mcp/store/messages.db
WHATSAPP_CHATS_DB=/path/to/whatsapp-mcp/store/whatsapp.db

# Local tasks database
TASKS_DB=/path/to/task-manager/tasks.db

# Ollama settings
OLLAMA_MODEL=qwen3:4b
OLLAMA_URL=http://localhost:11434

# Monitored contacts (comma-separated). You can use plain numbers (e.g. 5511999999999)
# or full JIDs (e.g. 5511999999999@s.whatsapp.net).
MONITORED_NUMBERS=

# Groups containing these keywords will be monitored (comma-separated)
MONITORED_GROUP_KEYWORDS=

# Polling interval in seconds (for daemon mode)
POLL_INTERVAL=30

# Portuguese task detection prompt (use \n for newlines)
TASK_PROMPT=Analise esta mensagem do WhatsApp em português brasileiro:\n\nMensagem: "{message}"\nRemetente: {sender}\nData: {timestamp}\n\nExiste uma tarefa, pedido, ou algo que precisa ser feito nesta mensagem?\n\nResponda APENAS em formato JSON:\n{{\n    "has_task": true/false,\n    "task_description": "descrição da tarefa em português",\n    "priority": "baixa/média/alta",\n    "deadline": "se houver prazo mencionado ou null"\n}}\n\nSe não há tarefa, retorne {{"has_task": false}}
